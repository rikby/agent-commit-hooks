{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/scripts/agent-oxc.ts\"",
            "timeout": 20,
            "statusMessage": "oxfmt + oxlint on the touched files"
          }
        ]
      }
    ]
  }
}
